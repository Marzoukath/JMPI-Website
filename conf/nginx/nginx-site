server {
    listen 80;
    server_name _;
    root /var/www/html/public;
    
    index index.php index.html;
    
    charset utf-8;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";

    # Logging
    error_log /dev/stdout info;
    access_log /dev/stdout;

    # Disable sendfile
    sendfile off;

    # Block access to sensitive files
    location /.git {
        deny all;
        return 403;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # CRITICAL: Main location block for Laravel
    location / {
        # Essayer le fichier directement, puis le dossier, puis rediriger vers index.php
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Handle favicon and robots
    location = /favicon.ico { 
        access_log off; 
        log_not_found off; 
        try_files $uri =204;
    }
    
    location = /robots.txt  { 
        access_log off; 
        log_not_found off; 
        try_files $uri =204;
    }

    # Static files caching
    location ~* \.(css|js|jpg|jpeg|gif|png|ico|svg|woff|woff2|ttf|eot|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # PHP-FPM configuration - CRITIQUE pour Laravel
    location ~ \.php$ {
        # Vérifier que le fichier existe
        try_files $uri =404;
        
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/var/run/php-fpm.sock;
        fastcgi_index index.php;
        
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        
        # Variables importantes pour Laravel
        fastcgi_param HTTP_HOST $host;
        fastcgi_param SERVER_NAME $host;
    }

    # Deny access to other sensitive files
    location ~ /\.(?!well-known).* {
        deny all;
    }
}